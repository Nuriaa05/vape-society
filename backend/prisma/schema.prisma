generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id           String     @id
  name         String
  phone        String
  email        String
  lastPurchase DateTime?
  active       Boolean    @default(true)
  notes        String?
  products     Product[]
  purchases    Purchase[]
  payables     SupplierPayable[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([name])
}

model Category {
  id        String    @id
  name      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PaymentMethod {
  id                   String   @id
  name                 String   @unique
  enabled              Boolean  @default(true)
  surchargeBasisPoints Int      @default(0)
  cashHandling         Boolean  @default(false)
  collectionEligible   Boolean  @default(false)
  supportsInstallments Boolean  @default(false)
  sales                Sale[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Coupon {
  id                  String   @id @default(cuid())
  code                String   @unique
  discountType        String
  discountBasisPoints Int?
  discountAmountCents Int?
  enabled             Boolean  @default(true)
  sales               Sale[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([enabled])
}

model Product {
  id               String              @id
  barcode          String?             @unique
  name             String
  categoryId       String
  supplierId       String?
  costAmountCents  Int
  priceAmountCents Int
  marginPct        Int
  physicalStock    Int                 @default(0)
  minStock         Int                 @default(0)
  saleEnabled      Boolean             @default(true)
  archived         Boolean             @default(false)
  category         Category            @relation(fields: [categoryId], references: [id])
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  saleItems        SaleItem[]
  comboItems       ComboItem[]
  saleComponents   SaleItemComponent[]
  purchaseItems    PurchaseItem[]
  stockMovements   StockMovement[]
  inventoryLots    InventoryLot[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([name])
}

model Combo {
  id               String      @id @default(cuid())
  barcode          String?     @unique
  name             String
  priceAmountCents Int
  archived         Boolean     @default(false)
  items            ComboItem[]
  saleItems        SaleItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([name])
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  productId String
  qty       Int
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@index([comboId])
  @@index([productId])
}

model Sale {
  id                      String           @id @default(cuid())
  number                  String           @unique
  date                    DateTime         @default(now())
  customerName            String?
  customerPhone           String?
  deliveryStatus          String
  status                  String
  paymentMethodId         String?
  customerId              String?
  paymentTerms            String?
  financeSnapshot         String?
  operationId             String?          @unique
  operationPayload        String?
  couponId                String?
  couponCode              String?
  couponType              String?
  couponBasisPoints       Int?
  couponValueAmountCents  Int?
  discountAmountCents     Int              @default(0)
  paymentMethodName       String           @default("")
  surchargeBasisPoints    Int              @default(0)
  surchargeAmountCents    Int              @default(0)
  cashReceivedAmountCents Int?
  changeAmountCents       Int?
  subtotalAmountCents     Int
  totalAmountCents        Int
  cancelReason            String?
  cancelledAt             DateTime?
  paymentMethod           PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  customer                Customer?        @relation(fields: [customerId], references: [id])
  receivablePlan          ReceivablePlan?
  cardSettlements         CardSettlement[]
  collections             Collection[]
  refunds                 Refund[]
  coupon                  Coupon?          @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items                   SaleItem[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([date])
  @@index([deliveryStatus])
  @@index([status])
  @@index([paymentMethodId])
  @@index([couponId])
}

model SaleItem {
  id                       String              @id @default(cuid())
  saleId                   String
  itemType                 String              @default("Product")
  productId                String?
  comboId                  String?
  productName              String
  barcode                  String
  qty                      Int
  unitPriceAmountCents     Int
  lineTotalAmountCents     Int
  comboDiscountAmountCents Int                 @default(0)
  sale                     Sale                @relation(fields: [saleId], references: [id])
  product                  Product?            @relation(fields: [productId], references: [id])
  combo                    Combo?              @relation(fields: [comboId], references: [id])
  components               SaleItemComponent[]

  @@index([saleId])
  @@index([productId])
  @@index([comboId])
  @@index([itemType])
}

model SaleItemComponent {
  id          String   @id @default(cuid())
  saleItemId  String
  productId   String
  productName String
  barcode     String
  qtyPerCombo Int
  totalQty    Int
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([saleItemId])
  @@index([productId])
}

model Purchase {
  id               String         @id @default(cuid())
  supplierId       String
  date             DateTime
  status           String
  totalAmountCents Int
  paymentCondition String        @default("SinSeguimiento")
  dueDate          String?
  paymentDate      String?
  paymentMethod    String?
  paymentReference String?
  payable          SupplierPayable?
  cancelReason     String?
  cancelledAt      DateTime?
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  items            PurchaseItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([supplierId])
  @@index([date])
  @@index([status])
}

model PurchaseItem {
  id                   String   @id @default(cuid())
  purchaseId           String
  productId            String
  productName          String
  qty                  Int
  unitCostAmountCents  Int
  lineTotalAmountCents Int
  purchase             Purchase @relation(fields: [purchaseId], references: [id])
  product              Product  @relation(fields: [productId], references: [id])
  inventoryLot         InventoryLot?

  @@index([purchaseId])
  @@index([productId])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  type          String
  sourceType    String
  sourceId      String
  physicalDelta Int
  unallocatedQty Int @default(0)
  note          String?
  reversalOfId  String?
  product       Product  @relation(fields: [productId], references: [id])
  inventoryLots InventoryLot[]
  allocations   InventoryAllocation[]
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([sourceType, sourceId])
  @@index([reversalOfId])
}

model BusinessSettings {
  id        String   @id
  name      String
  address   String
  cuit      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceiptSettings {
  id        String   @id
  header    String
  footer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                 String   @id
  defaultMarginPct   Int
  comboTicketMode    String   @default("ComboLine")
  dailyBackupEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Counter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  path      String
  sizeBytes Int
  status    String
  createdAt DateTime @default(now())
}

model Customer {
  id          String           @id @default(cuid())
  name        String
  phone       String?
  notes       String?
  active      Boolean          @default(true)
  sales       Sale[]
  plans       ReceivablePlan[]
  collections Collection[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([name])
}

model ReceivablePlan {
  id               String                  @id @default(cuid())
  customerId       String
  saleId           String?                 @unique
  title            String
  totalAmountCents Int
  status           String                  @default("Activo")
  cancelReason     String?
  cancelledAt      DateTime?
  customer         Customer                @relation(fields: [customerId], references: [id])
  sale             Sale?                   @relation(fields: [saleId], references: [id])
  installments     ReceivableInstallment[]
  refunds          Refund[]
  createdAt        DateTime                @default(now())

  @@index([customerId])
}

model ReceivableInstallment {
  id          String                 @id @default(cuid())
  planId      String
  number      Int
  dueDate     String
  amountCents Int
  plan        ReceivablePlan         @relation(fields: [planId], references: [id])
  allocations CollectionAllocation[]

  @@unique([planId, number])
  @@index([dueDate])
}

model Collection {
  id                      String                 @id @default(cuid())
  customerId              String?
  customerName            String?
  saleId                  String?
  date                    String
  kind                    String                 @default("Direct")
  paymentMethodId         String
  paymentMethodName       String
  amountCents             Int
  cashReceivedAmountCents Int?
  changeAmountCents       Int?
  reversedAt              DateTime?
  reversalReason          String?
  customer                Customer?              @relation(fields: [customerId], references: [id])
  sale                    Sale?                  @relation(fields: [saleId], references: [id])
  allocations             CollectionAllocation[]
  createdAt               DateTime               @default(now())

  @@index([date])
  @@index([customerId])
  @@index([saleId])
}

model CollectionAllocation {
  id            String                @id @default(cuid())
  collectionId  String
  installmentId String
  amountCents   Int
  collection    Collection            @relation(fields: [collectionId], references: [id])
  installment   ReceivableInstallment @relation(fields: [installmentId], references: [id])

  @@unique([collectionId, installmentId])
  @@index([installmentId])
}

model CardSettlement {
  id               String               @id @default(cuid())
  saleId           String
  processor        String
  reference        String?
  number           Int
  dueDate          String
  grossAmountCents Int
  feeAmountCents   Int
  sale             Sale                 @relation(fields: [saleId], references: [id])
  accreditations   CardAccreditation[]
  cancellations    RefundCancellation[]

  @@unique([saleId, number])
  @@index([dueDate])
}

model CardAccreditation {
  id               String         @id @default(cuid())
  settlementId     String
  date             String
  grossAmountCents Int
  feeAmountCents   Int
  reference        String?
  reversedAt       DateTime?
  reversalReason   String?
  settlement       CardSettlement @relation(fields: [settlementId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([date])
}

model Refund {
  id                 String               @id @default(cuid())
  saleId             String?
  planId             String?
  customerId         String?
  customerName       String?
  date               String
  amountCents        Int
  cashOutAmountCents Int
  paymentMethodId    String?
  paymentMethodName  String
  reason             String
  reversedAt         DateTime?
  reversalReason     String?
  sale               Sale?                @relation(fields: [saleId], references: [id])
  plan               ReceivablePlan?      @relation(fields: [planId], references: [id])
  cancellations      RefundCancellation[]
  createdAt          DateTime             @default(now())

  @@index([date])
  @@index([customerId])
}

model RefundCancellation {
  id               String         @id @default(cuid())
  refundId         String
  settlementId     String
  grossAmountCents Int
  refund           Refund         @relation(fields: [refundId], references: [id])
  settlement       CardSettlement @relation(fields: [settlementId], references: [id])

  @@unique([refundId, settlementId])
}

model FinancialOperation {
  operationId String   @id
  kind        String
  payload     String
  resultId    String
  createdAt   DateTime @default(now())
}

model SupplierPayable {
  id           String @id @default(cuid())
  supplierId   String
  purchaseId   String? @unique
  title        String
  amountCents  Int
  dueDate      String
  status       String @default("Activa")
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime @default(now())
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  purchase     Purchase? @relation(fields: [purchaseId], references: [id])
  payments     SupplierPayment[]
  refunds      SupplierRefund[]
  lots         InventoryLot[]

  @@index([supplierId])
  @@index([dueDate])
}

model SupplierPayment {
  id             String @id @default(cuid())
  payableId      String
  date           String
  method         String
  reference      String?
  amountCents    Int
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime @default(now())
  payable        SupplierPayable @relation(fields: [payableId], references: [id])

  @@index([payableId])
  @@index([date])
}

model SupplierRefund {
  id             String @id @default(cuid())
  payableId      String
  date           String
  method         String
  reference      String?
  amountCents    Int
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime @default(now())
  payable        SupplierPayable @relation(fields: [payableId], references: [id])

  @@index([payableId])
  @@index([date])
}

model InventoryLot {
  id                  String @id @default(cuid())
  productId           String
  purchaseItemId      String? @unique
  payableId           String?
  originMovementId    String?
  classification      String
  unitCostAmountCents Int
  receivedAt          DateTime
  initialQty          Int
  remainingQty        Int
  createdAt           DateTime @default(now())
  product             Product @relation(fields: [productId], references: [id])
  purchaseItem        PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  payable             SupplierPayable? @relation(fields: [payableId], references: [id])
  originMovement      StockMovement? @relation(fields: [originMovementId], references: [id])
  allocations         InventoryAllocation[]

  @@index([productId, receivedAt])
  @@index([payableId])
  @@index([originMovementId])
}

model InventoryAllocation {
  id              String @id @default(cuid())
  lotId           String
  stockMovementId String
  qty             Int
  lot             InventoryLot @relation(fields: [lotId], references: [id])
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id])

  @@unique([lotId, stockMovementId])
  @@index([stockMovementId])
}
