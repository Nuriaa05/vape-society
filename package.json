{
  "name": "lozano-core",
  "version": "0.1.1",
  "private": true,
  "description": "Base comercial independiente extraída de Lozano",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "setup": "node scripts/core.mjs setup",
    "db:init": "node scripts/core.mjs db:init",
    "dev": "node scripts/core.mjs dev",
    "start": "node scripts/core.mjs start",
    "typecheck": "node scripts/core.mjs typecheck",
    "lint": "node scripts/core.mjs lint",
    "test": "node scripts/core.mjs test",
    "build": "node scripts/core.mjs build",
    "test:smoke": "node scripts/smoke.cjs",
    "build:installer": "node scripts/windows/build-installer.mjs",
    "test:installer": "node --test scripts/windows/runtime.test.cjs"
  }
